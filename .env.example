# Configuración Catalogador DSpace
OPENAI_API_KEY=tu_clave_de_openai_aqui
DSPACE_URL=https://tu-repositorio-dspace.cl/server/api
DSPACE_EMAIL=tu_usuario@institucion.cl
DSPACE_PASSWORD=tu_contraseña_aqui
DSPACE_COLLECTION_UUID=tu_uuid_de_coleccion
DSPACE_COLLECTION_HANDLE=tu_handle_de_coleccion

# Opciones de Modelo
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_EFFORT=low
OPENAI_IMAGE_DETAIL=high
OPENAI_TEMPERATURE=0.2
